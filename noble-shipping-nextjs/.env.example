# Environment Configuration
# Copy this file to .env or .env.local and update values as needed

# SQLite Cloud Database Connection String
# Format: sqlitecloud://host:port/database_name.db?apikey=YOUR_API_KEY
# Replace with your own SQLite Cloud credentials
# Components: host (czfztvaivz.g4.sqlite.cloud), port (8860), database (Cargo_backup_November_24.db), apikey
DATABASE_URL="sqlitecloud://your_host.g4.sqlite.cloud:8860/your_database.db?apikey=YOUR_API_KEY_HERE"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# App Configuration
NODE_ENV="development"
MAX_FILE_SIZE="10485760" # 10MB

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="noreply@nobleshipping.com"
SMTP_FROM_NAME="Noble Shipping Company"

# Default Admin Credentials
DEFAULT_ADMIN_EMAIL="admin@nobleshipping.com"
DEFAULT_ADMIN_PASSWORD="admin"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Security
SESSION_SECRET="your-session-secret-here"
CSRF_SECRET="your-csrf-secret-here"