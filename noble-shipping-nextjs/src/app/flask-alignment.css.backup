.s-section-title h6 {
    color: #ff4612 !important;
}

/* Tracking List */
.tracking-list ul li.active .tracking-list-icon {
    background: #ff4612 !important;
    color: #fff !important;
}

.tracking-list ul li.active .tracking-list-icon i {
    color: #fff !important;
}

/* FAQ Tabs */
